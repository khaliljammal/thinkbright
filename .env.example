# Copy to .env and fill in. Everything here ships in the client bundle,
# so only ever put publishable keys in this file.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys → Apple App Store (public SDK key)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# PostHog → Project settings (optional)
EXPO_PUBLIC_POSTHOG_KEY=
